# Shared reference values. Client apps only need anon-safe values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
PENNYRUSH_SUPABASE_URL=
PENNYRUSH_SUPABASE_ANON_KEY=

# Android release signing. Keep real values in android/local.properties or CI secrets.
PENNYRUSH_RELEASE_STORE_FILE=
PENNYRUSH_RELEASE_STORE_PASSWORD=
PENNYRUSH_RELEASE_KEY_ALIAS=
PENNYRUSH_RELEASE_KEY_PASSWORD=

# Supabase Edge Function secrets. Never expose these in client bundles.
SUPABASE_SERVICE_ROLE_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional email provider for reminders.
RESEND_API_KEY=
