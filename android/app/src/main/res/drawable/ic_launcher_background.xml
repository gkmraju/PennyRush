<vector xmlns:aapt="http://schemas.android.com/aapt"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="linear"
                android:startX="0"
                android:startY="108"
                android:endX="108"
                android:endY="0"
                android:startColor="#B4531B"
                android:endColor="#F0A16A" />
        </aapt:attr>
    </path>
    <!--
        Copper, the same two values the app theme is built from: Copper for
        primary and CopperBright for the accents. The icon used to be an
        emerald gradient, which meant the thing on the home screen and the
        thing that opened from it looked like two different apps.

        The slate ring came from that green palette and had nothing to stand
        on once the ground changed, so it is gone rather than recoloured.
    -->
</vector>
